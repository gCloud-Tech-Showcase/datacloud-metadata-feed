config {
  type: "assertion",
  description: "QUALITY: EXAMPLE — serving rows must have a unique word and sane counts",
  tags: ["__DOMAIN_TAG__", "assertions", "quality"]
}

/*
  EXAMPLE — replace with assertions over your own tables.

  An assertion returns the rows that should NOT exist. Empty result = pass;
  ANY row fails the whole workflow run. Use it only where a healthy pipeline
  returns zero rows and a human could actually fix the data. Anything that is a
  RATE (model drift, quality metrics) belongs in monitoring/ instead — hard
  failing on it leaves the pipeline permanently red for something no data fix
  resolves.

  Note CAST(NULL AS STRING): a bare NULL is typed INT64 and the UNION ALL then
  fails with "Column 1 ... incompatible types". This bites every time.
*/

SELECT
  word,
  COUNT(*) AS row_count,
  'duplicate_word' AS violation
FROM ${ref("example_top_words")}
GROUP BY word
HAVING COUNT(*) > 1

UNION ALL

SELECT
  CAST(NULL AS STRING) AS word,
  COUNT(*) AS row_count,
  'null_word' AS violation
FROM ${ref("example_top_words")}
WHERE word IS NULL
HAVING COUNT(*) > 0

UNION ALL

SELECT
  word,
  total_occurrences AS row_count,
  'non_positive_count' AS violation
FROM ${ref("example_top_words")}
WHERE total_occurrences <= 0
