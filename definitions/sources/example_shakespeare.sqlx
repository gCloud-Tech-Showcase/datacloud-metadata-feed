config {
  type: "declaration",
  database: "bigquery-public-data",
  schema: "samples",
  name: "shakespeare",
  description: "EXAMPLE: public sample table, proves the pipeline runs end-to-end before any domain SQL exists"
}

/*
  EXAMPLE — delete this file once your own sources exist.

  A declaration points at a table Dataform does NOT create. Nothing is copied;
  it just makes the table `ref()`-able. Use one for every external or
  Terraform-managed table you read.

  Declarations support ONLY type / database / schema / name / description.
  Adding `tags` here fails the compile.
*/
