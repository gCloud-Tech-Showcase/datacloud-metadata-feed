config {
  type: "view",
  schema: "assertions",
  description: "QUALITY: EXAMPLE — words appearing in only one work; expected to be non-empty, watch the trend",
  tags: ["__DOMAIN_TAG__", "monitoring", "quality"],
  columns: {
    word: "The word",
    total_occurrences: "Occurrences across the corpus",
    works_appearing_in: "Distinct works containing it"
  }
}

/*
  EXAMPLE — replace with monitoring over your own tables.

  Warning-level, deliberately. Non-empty is EXPECTED here, so this must not be
  an assertion — the point is the rate, not any single row. Use monitoring/ for
  known-imperfect upstream behaviour and for trend signals where a rising count
  is the alert.

  Note `schema: "assertions"` is set explicitly. `type: "view"` otherwise
  defaults to defaultDataset (serving), not defaultAssertionDataset — the one
  thing that reliably catches people out about monitoring views.
*/

SELECT
  word,
  total_occurrences,
  works_appearing_in
FROM ${ref("example_top_words")}
WHERE works_appearing_in = 1
ORDER BY total_occurrences DESC
