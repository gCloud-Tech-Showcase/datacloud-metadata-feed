config {
  type: "table",
  schema: "serving",
  description: "SERVING: EXAMPLE — most frequent words across the Shakespeare corpus",
  tags: ["__DOMAIN_TAG__", "serving", "marts"],
  columns: {
    word: "The word, lowercased",
    total_occurrences: "Occurrences across every work",
    works_appearing_in: "How many distinct works contain the word"
  }
}

/*
  EXAMPLE — delete once your own serving stage exists.

  Serving is what a consumer queries. Note the table name carries NO medallion
  prefix: the dataset already says the stage, so `serving.example_top_words`,
  never `serving.gold_example_top_words`.
*/

SELECT
  word,
  SUM(word_count)      AS total_occurrences,
  COUNT(DISTINCT corpus) AS works_appearing_in
FROM ${ref("example_word_counts")}
GROUP BY word
HAVING SUM(word_count) >= 100
ORDER BY total_occurrences DESC
