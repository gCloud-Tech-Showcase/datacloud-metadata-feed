# No variables are REQUIRED — every one has a default. A tfvars file is optional.
# Point the domain at your own GCP project by overriding project_id (via this file,
# `-var`, or `TF_VAR_project_id`); the rest are fine as-is.

# --- Optional overrides (defaults shown) ---

# project_id       = "datacloud-metadata-feed"
# region           = "us-central1"
# dataset_location = "US"
# git_repo_url     = "https://github.com/gCloud-Tech-Showcase/datacloud-metadata-feed.git"

# Run the Dataform pipeline as the final step of apply (blocks ~2-4 min until it
# finishes). Needs curl + python3 (bundled with gcloud). Set false to skip.
# run_pipeline_on_apply = true

# Create the hourly release + workflow schedule (self-refreshing pipeline). Off by
# default: a clone-and-apply is a one-shot build with no recurring BQML retrain.
# enable_scheduled_runs = false
