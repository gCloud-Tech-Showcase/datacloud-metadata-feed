# =============================================================================
# DATAFORM GIT LINK — PRIVATE REPO
# The PRIVATE half of the [visibility:*] pair — init.sh deletes this whole file
# for a public domain and keeps dataform_git_public.tf instead. Exactly one of
# the two survives. (Wildcard, so the tag stripper can't eat this line.)
#
# A private repo can't be reached anonymously, so Dataform authenticates with an
# SSH deploy key: repo-scoped rather than account-scoped, and read-only, which
# makes it a materially smaller credential than the PAT the provider would
# otherwise take (authentication_token_secret_version is HTTPS-only).
#
# The key pair is generated by infra/scripts/setup.sh, NOT by Tofu. The provider
# takes a Secret Manager *version name* — never key material — so nothing in
# this graph needs the private key as a value. Generating it here with
# tls_private_key would write it to state in plaintext, and the usual fix for
# that (CMEK on the state bucket) drags in a whole bootstrap stage. Keeping the
# key out of the graph avoids both.
#
# Rotation is therefore a setup.sh concern too: reissue the key, add a new
# secret version, replace the GitHub deploy key, and re-apply so the data source
# below resolves to the new version.
# =============================================================================

# Resolves the "latest" alias to a concrete version, so the repository pins one
# and rotation is a visible diff rather than a silent swap. fetch_secret_data is
# off deliberately: the default is TRUE, and leaving it on would pull the
# private key into state — the exact thing this whole arrangement avoids.
data "google_secret_manager_secret_version" "dataform_deploy_key" {
  project           = var.project_id
  secret            = var.deploy_key_secret_id
  fetch_secret_data = false

  depends_on = [google_project_service.apis["secretmanager.googleapis.com"]]
}

# Granted on the secret rather than the project, so nothing else inherits read
# access to it. The Dataform service agent — not the runner SA — is what pulls
# from git, so it's the identity that needs this.
resource "google_secret_manager_secret_iam_member" "dataform_deploy_key_accessor" {
  project   = var.project_id
  secret_id = var.deploy_key_secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_project_service_identity.dataform.email}"
}

resource "google_dataform_repository" "this" {
  provider = google-beta
  project  = var.project_id
  region   = var.region
  name     = local.dataform_repository_name

  # Matches the public path's `?force=true` delete: without it, `tofu destroy`
  # fails once the repository has compilation results or workspaces under it.
  deletion_policy = "FORCE"

  git_remote_settings {
    url            = var.git_repo_ssh_url
    default_branch = "main"

    ssh_authentication_config {
      user_private_key_secret_version = data.google_secret_manager_secret_version.dataform_deploy_key.name
      host_public_key                 = var.git_host_public_key
    }
  }

  depends_on = [
    google_secret_manager_secret_iam_member.dataform_deploy_key_accessor,
    google_project_service_identity.dataform,
    google_project_service.apis["dataform.googleapis.com"],
  ]
}
